generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

// Note: Update this path if you change the structure

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}


// Base User Model - Common fields only
model User {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  email         String    @unique
  password      String?
  emailVerified DateTime? @map("email_verified")
  image         String?
  role          UserRole
  isActive      Boolean   @default(true) @map("is_active")
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  accounts         Account[]
  sessions         Session[]
  refreshTokens    RefreshToken[]
  passwordResets   PasswordReset[]
  candidateProfile CandidateProfile?
  recruiterProfile RecruiterProfile?
  adminProfile     AdminProfile?
  
  // Problem solving platform relations
  submissions      Submission[]
  problemStatuses  UserProblemStatus[]

  @@map("users")
}

// Candidate-specific data
model CandidateProfile {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  userId          String    @unique @map("user_id")
  firstName       String    @map("first_name")
  lastName        String    @map("last_name")
  phone           String?
  dateOfBirth     DateTime? @map("date_of_birth")
  gender          Gender?
  address         String?
  city            String?
  state           String?
  country         String?
  zipCode         String?   @map("zip_code")
  linkedinUrl     String?   @map("linkedin_url")
  portfolioUrl    String?   @map("portfolio_url")
  githubUrl       String?   @map("github_url")
  summary         String?   
  expectedSalary  Int?      @map("expected_salary")
  currentSalary   Int?      @map("current_salary")
  experienceYears Int?      @map("experience_years")
  availability    String?   // immediate, 2weeks, 1month, etc
  workType        WorkType? @map("work_type") // remote, onsite, hybrid
  isOpenToWork    Boolean   @default(true) @map("is_open_to_work")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills       CandidateSkill[]
  experiences  WorkExperience[]
  educations   Education[]
  applications JobApplication[]

  @@map("candidate_profiles")
}

// Recruiter-specific data
model RecruiterProfile {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @unique @map("user_id")
  firstName       String   @map("first_name")
  lastName        String   @map("last_name")
  phone           String?
  companyName     String   @map("company_name")
  companySize     String?  @map("company_size") // 1-10, 11-50, 51-200, etc
  industry        String?
  website         String?
  linkedinUrl     String?  @map("linkedin_url")
  companyAddress  String?  @map("company_address")
  city            String?
  state           String?
  country         String?
  zipCode         String?  @map("zip_code")
  jobTitle        String?  @map("job_title")
  department      String?
  isVerified      Boolean  @default(false) @map("is_verified")
  verifiedAt      DateTime? @map("verified_at")
  subscriptionPlan String? @map("subscription_plan") // free, basic, premium
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPosts JobPost[]

  @@map("recruiter_profiles")
}

// Admin-specific data
model AdminProfile {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @unique @map("user_id")
  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  phone       String?
  department  String?
  permissions String[] // array of permissions
  isSuperAdmin Boolean @default(false) @map("is_super_admin")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_profiles")
}

// Supporting models
model CandidateSkill {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  candidateId String   @map("candidate_id")
  skillName   String   @map("skill_name")
  level       SkillLevel // beginner, intermediate, advanced, expert
  yearsOfExp  Int?     @map("years_of_exp")
  createdAt   DateTime @default(now()) @map("created_at")

  candidate CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("candidate_skills")
}

model WorkExperience {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  candidateId String    @map("candidate_id")
  jobTitle    String    @map("job_title")
  companyName String    @map("company_name")
  location    String?
  startDate   DateTime  @map("start_date")
  endDate     DateTime? @map("end_date")
  isCurrent   Boolean   @default(false) @map("is_current")
  description String?   
  createdAt   DateTime  @default(now()) @map("created_at")

  candidate CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("work_experiences")
}

model Education {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  candidateId String    @map("candidate_id")
  degree      String
  fieldOfStudy String   @map("field_of_study")
  institution String
  location    String?
  startDate   DateTime  @map("start_date")
  endDate     DateTime? @map("end_date")
  gpa         Float?
  description String?  
  createdAt   DateTime  @default(now()) @map("created_at")

  candidate CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("educations")
}

model JobPost {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  recruiterId  String   @map("recruiter_id")
  title        String
  description  String   
  requirements String   
  location     String?
  workType     WorkType @map("work_type")
  employmentType String @map("employment_type") // full-time, part-time, contract
  salaryMin    Int?     @map("salary_min")
  salaryMax    Int?     @map("salary_max")
  currency     String   @default("USD")
  isActive     Boolean  @default(true) @map("is_active")
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  recruiter    RecruiterProfile @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  applications JobApplication[]

  @@map("job_posts")
}

model JobApplication {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  candidateId String            @map("candidate_id")
  jobPostId   String            @map("job_post_id")
  status      ApplicationStatus @default(PENDING)
  coverLetter String?           @map("cover_letter") 
  resumeUrl   String?           @map("resume_url")
  appliedAt   DateTime          @default(now()) @map("applied_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  candidate CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobPost   JobPost          @relation(fields: [jobPostId], references: [id], onDelete: Cascade)

  @@unique([candidateId, jobPostId])
  @@map("job_applications")
}

// Auth-related models (unchanged)
model Account {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? 
  access_token      String? 
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? 
  session_state     String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model RefreshToken {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  revoked   Boolean  @default(false)
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model PasswordReset {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  userId    String   @map("user_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}


// Enums
enum UserRole {
  ADMIN
  CANDIDATE
  RECRUITER
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum WorkType {
  REMOTE
  ONSITE
  HYBRID
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum ApplicationStatus {
  PENDING
  REVIEWED
  SHORTLISTED
  INTERVIEWED
  OFFERED
  REJECTED
  WITHDRAWN
}

// Problem Solving Platform Models
model Topic {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  slug        String   @unique
  description String?
  difficulty  TopicDifficulty
  type        TopicType
  problemCount Int     @default(0) @map("problem_count")
  tags        String[] // e.g., ["Architecture", "Languages", "Operations"]
  isActive    Boolean  @default(true) @map("is_active")
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  problems Problem[]

  @@map("topics")
}

model Problem {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  topicId     String   @map("topic_id")
  title       String
  slug        String   @unique
  description String
  difficulty  ProblemDifficulty
  tags        String[] // e.g., ["Sorting", "Greedy", "Implementation"]
  companyTags String[] @map("company_tags") // e.g., ["Google", "Microsoft"]
  timeLimit   Int      @default(3000) @map("time_limit") // in milliseconds
  memoryLimit Int      @default(256) @map("memory_limit") // in MB
  successRate Float    @default(0) @map("success_rate")
  score       Int      @default(0)
  solvedBy    String[] @default([]) @map("solved_by") // Array of user IDs who solved this problem
  isActive    Boolean  @default(true) @map("is_active")
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  topic           Topic              @relation(fields: [topicId], references: [id], onDelete: Cascade)
  submissions     Submission[]
  testCases       TestCase[]
  solutions       Solution[]
  userStatuses    UserProblemStatus[]

  @@index([isActive, topicId])
  @@index([isActive, difficulty])
  @@index([order])
  @@index([createdAt])
  @@index([tags])
  @@index([companyTags])
  @@map("problems")
}

model TestCase {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  problemId String   @map("problem_id")
  input     String
  output    String
  isHidden  Boolean  @default(false) @map("is_hidden")
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@map("test_cases")
}

model Solution {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  problemId String   @map("problem_id")
  language  String   // e.g., "python", "javascript", "java"
  code      String
  isOfficial Boolean @default(false) @map("is_official")
  createdAt DateTime @default(now()) @map("created_at")

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@map("solutions")
}

model Submission {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @map("user_id")
  problemId String   @map("problem_id")
  language  String   // e.g., "python", "javascript", "java"
  code      String
  status    SubmissionStatus
  runtime   Int?     // in milliseconds
  memory    Int?     // in MB
  score     Int?     // percentage score
  error     String?  // error message if failed
  testResults TestResult[]
  submittedAt DateTime @default(now()) @map("submitted_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@map("submissions")
}

model TestResult {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  submissionId String   @map("submission_id")
  testCaseId   String   @map("test_case_id")
  status       TestResultStatus
  input        String
  expectedOutput String @map("expected_output")
  actualOutput String? @map("actual_output")
  runtime      Int?    // in milliseconds
  memory       Int?    // in MB
  error        String?
  createdAt    DateTime @default(now()) @map("created_at")

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("test_results")
}

model UserProblemStatus {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @map("user_id")
  problemId String   @map("problem_id")
  status    ProblemStatus
  lastAttempted DateTime? @map("last_attempted")
  bestScore  Int?     @map("best_score")
  attempts   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@map("user_problem_status")
}

enum TopicDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum TopicType {
  CORE_CS
  SPECIALIZED
  LANGUAGE
  FRAMEWORK
  TOOL
}

enum ProblemDifficulty {
  EASY
  MEDIUM
  HARD
}

enum SubmissionStatus {
  PENDING
  RUNNING
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  RUNTIME_ERROR
  COMPILATION_ERROR
  SYSTEM_ERROR
}

enum TestResultStatus {
  PASSED
  FAILED
  ERROR
}

enum ProblemStatus {
  UNSOLVED
  ATTEMPTED
  SOLVED
}

